# ==============================================================================
# Educaro Compass - Environment Configuration (.env)
# ==============================================================================

# Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
# Hosted Neon / Supabase (Pooled):
# DATABASE_URL="postgresql://user:password@ep-sample-pooler.eu-central-1.aws.neon.tech/educaro?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://user:password@ep-sample.eu-central-1.aws.neon.tech/educaro?sslmode=require"
#
# Local PostgreSQL Install (e.g., Windows default port 5432):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/educaro_compass?schema=public"
# DIRECT_URL is optional for non-pooled local databases; fallbacks to DATABASE_URL if omitted:
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/educaro_compass?schema=public"

# Application Settings
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_educaro_compass_hackathon_2026
JWT_EXPIRATION=7d

# AI Providers
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
# Set to 'true' to use MockProvider (fast deterministic fixtures without external API keys)
DEMO_MODE=true

# Storage
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
